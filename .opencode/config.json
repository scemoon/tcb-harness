{
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 40000
  },
  "skills": {
    "paths": [".opencode/skills"]
  },
  "plugin": ["./plugin/cdh-ai-dlc.ts"],
  "agent": {
    "ai-dlc-understand": {
      "description": "Understand Phase: Intent → Spec Delta (EARS) → BDD Feature Files",
      "mode": "subagent",
      "prompt": "{file:./ai-dlc-skill/phases/understand/prompt.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "ai-dlc-plan": {
      "description": "Plan Phase: Design Doc → Task DAG → Test Plan",
      "mode": "subagent",
      "prompt": "{file:./ai-dlc-skill/phases/plan/prompt.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "ai-dlc-verify": {
      "description": "Verify Phase: TDD Red-Green-Refactor → Contract Test → Quality Gates",
      "mode": "subagent",
      "prompt": "{file:./ai-dlc-skill/phases/verify/prompt.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    },
    "ai-dlc-deliver": {
      "description": "Deliver Phase: Stack Preview → e2e → Production + BVT",
      "mode": "subagent",
      "prompt": "{file:./ai-dlc-skill/phases/deliver/prompt.md}",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow"
      }
    }
  }
}
