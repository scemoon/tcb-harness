<!-- pages/index/index.wxml -->\n<view class=\"container\">\n  <!-- 顶部标题 -->\n  <view class=\"header\">\n    <text class=\"title\">悦读</text>\n    <view class=\"search-btn\" bindtap=\"goToSearch\">\n      <image src=\"/images/icons/search.png\" />\n    </view>\n  </view>\n\n  <!-- Tab切换 -->\n  <view class=\"tab-bar\">\n    <view class=\"tab {{currentTab==='bookshelf'?'active':''}}\" bindtap=\"switchTab\" data-tab=\"bookshelf\">\n      <text>书架</text>\n    </view>\n    <view class=\"tab {{currentTab==='discover'?'active':''}}\" bindtap=\"switchTab\" data-tab=\"discover\">\n      <text>发现</text>\n    </view>\n  </view>\n\n  <!-- 书架视图 -->\n  <scroll-view class=\"bookshelf-view\" scroll-y wx:if=\"{{currentTab==='bookshelf'}}\">\n    <view class=\"books-grid\" wx:if=\"{{bookshelfBooks.length>0}}\">\n      <view class=\"book-card\" wx:for=\"{{bookshelfBooks}}\" wx:key=\"id\" bindtap=\"openReader\" data-bookid=\"{{item.id}}\">\n        <image src=\"{{item.cover}}\" class=\"book-cover\" mode=\"aspectFill\" />\n        <text class=\"book-title\">{{item.title}}</text>\n        <text class=\"book-author\">{{item.author}}</text>\n        <view class=\"progress-bar\" wx:if=\"{{getProgress(item.id)}}\">\n          <view class=\"progress-fill\" style=\"width:{{getProgress(item.id)}}%\"></view>\n        </view>\n      </view>\n    </view>\n    <view class=\"empty-state\" wx:else>\n      <text>书架空空如也</text>\n      <button bindtap=\"switchTab\" data-tab=\"discover\">去发现书籍</button>\n    </view>\n  </scroll-view>\n\n  <!-- 发现视图 -->\n  <scroll-view class=\"discover-view\" scroll-y wx:if=\"{{currentTab==='discover'}}\">\n    <!-- 轮播 -->\n    <swiper class=\"banner\" autoplay circular indicator-dots>\n      <swiper-item wx:for=\"{{bannerBooks}}\" wx:key=\"id\">\n        <view class=\"banner-item\" bindtap=\"openReader\" data-bookid=\"{{item.id}}\">\n          <image src=\"{{item.cover}}\" mode=\"aspectFill\" />\n          <view class=\"banner-info\">\n            <text class=\"banner-title\">{{item.title}}</text>\n            <text class=\"banner-author\">{{item.author}}</text>\n          </view>\n        </view>\n      </swiper-item>\n    </swiper>\n\n    <!-- 分类 -->\n    <view class=\"section\">\n      <view class=\"section-header\">\n        <text class=\"section-title\">分类</text>\n      </view>\n      <view class=\"category-list\">\n        <view class=\"category-item\" wx:for=\"{{categories}}\" wx:key=\"name\" bindtap=\"goToCategory\" data-category=\"{{item.name}}\">\n          <text class=\"category-icon\">{{item.icon}}</text>\n          <text class=\"category-name\">{{item.name}}</text>\n        </view>\n      </view>\n    </view>\n\n    <!-- 热门 -->\n    <view class=\"section\">\n      <view class=\"section-header\">\n        <text class=\"section-title\">热门书籍</text>\n      </view>\n      <view class=\"hot-list\">\n        <view class=\"hot-item\" wx:for=\"{{hotBooks}}\" wx:key=\"id\" bindtap=\"openReader\" data-bookid=\"{{item.id}}\">\n          <image src=\"{{item.cover}}\" class=\"hot-cover\" mode=\"aspectFill\" />\n          <view class=\"hot-info\">\n            <text class=\"hot-title\">{{item.title}}</text>\n            <text class=\"hot-author\">{{item.author}}</text>\n            <view class=\"hot-rating\">\n              <text>评分: {{item.rating}}</text>\n            </view>\n          </view>\n          <view class=\"add-btn\" catchtap=\"addToBookshelf\" data-bookid=\"{{item.id}}\">+</view>\n        </view>\n      </view>\n    </view>\n  </scroll-view>\n\n  <!-- 底部导航 -->\n  <view class=\"bottom-nav\">\n    <view class=\"nav-item active\">\n      <text class=\"nav-icon\">📚</text>\n      <text>书架</text>\n    </view>\n    <view class=\"nav-item\" bindtap=\"goToSearch\">\n      <text class=\"nav-icon\">🔍</text>\n      <text>搜索</text>\n    </view>\n    <view class=\"nav-item\" bindtap=\"goToBookmarks\">\n      <text class=\"nav-icon\">🔖</text>\n      <text>书签</text>\n    </view>\n    <view class=\"nav-item\" bindtap=\"goToProfile\">\n      <text class=\"nav-icon\">👤</text>\n      <text>我的</text>\n    </view>\n  </view>\n</view>\n